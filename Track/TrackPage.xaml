<Page x:Class="TimeTrackerWPF.Track.TrackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="TrackPage">

    <StackPanel Margin="20">
        <TextBox x:Name="NameTextBox" Width="200" Height="25" Margin="0,0,0,10" />
        <Button Content="Start" Click="StartButton_Click" Width="100" Margin="0,0,0,5"/>
        <Button Content="Stop" Click="StopButton_Click" Width="100" Margin="0,0,0,5"/>
        <Button Content="Reset" Click="ResetButton_Click" Width="100" Margin="0,0,0,10"/>
        <TextBlock  TextAlignment="Center" x:Name="TimerText" FontSize="18"/>
    </StackPanel>
</Page>
